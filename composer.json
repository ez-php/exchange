{
  "name": "ez-php/exchange",
  "version": "2.4.9",
  "description": "Currency exchange-rate lookup and conversion for Money values",
  "type": "library",
  "license": "MIT",
  "authors": [
    {
      "name": "Andreas Uretschnig",
      "email": "andreas.uretschnig@gmail.com"
    }
  ],
  "keywords": ["exchange", "currency", "money", "conversion", "php", "ez-php"],
  "homepage": "https://github.com/ez-php/exchange",
  "support": {
    "issues": "https://github.com/ez-php/exchange/issues",
    "source": "https://github.com/ez-php/exchange"
  },
  "require": {
    "php": "^8.5",
    "ez-php/bignum": "^2.0",
    "ez-php/money": "^2.0",
    "ez-php/http-client": "^2.0"
  },
  "suggest": {
    "ez-php/cache": "Needed for CachingExchangeRateProvider"
  },
  "require-dev": {
    "ez-php/docker": "^2.0",
    "ez-php/cache": "^2.0",
    "phpunit/phpunit": "^13.0",
    "phpstan/phpstan": "^2.1",
    "friendsofphp/php-cs-fixer": "^3.94",
    "phpstan/phpstan-strict-rules": "^2.0",
    "phpstan/phpstan-deprecation-rules": "^2.0"
  },
  "autoload": {
    "psr-4": {
      "EzPhp\\Exchange\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Tests\\": "tests/"
    }
  },
  "scripts": {
    "cs": "php-cs-fixer fix",
    "analyse": "phpstan analyse",
    "test": "phpunit",
    "full": "composer analyse && composer cs && composer test"
  }
}
